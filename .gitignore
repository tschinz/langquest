.DS_Store

# Claude stuff
tasks/
claude.md

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Environment files containing secrets
.env
.env.*
!.env.template

# Security reports
security-report.json
trivy-results.sarif
supply-chain-report.json

# Machine-bound attestation — never commit (regenerated per machine).
# The encrypted progress file `.lq.progress` is intentionally NOT ignored: it is
# written into the *exercise* repo and should be TRACKED there so it syncs across
# a student's machines — see README "Progress, identity & syncing".
.lq.attest
